# Copy to .env; keep real configuration out of Git.
# Paste your ADE URL locally. Calendar links may reveal your schedule.
ADE_ICS_URL=
APP_TIMEZONE=Europe/Paris
# Reserved for future SQLite persistence.
DATABASE_PATH=data/unified_schedule.sqlite3

# Optional automatic Workforce login; fill these only in your ignored .env.
WORKFORCE_EMAIL=
WORKFORCE_PASSWORD=

# Google Calendar preview target; choose explicitly after listing calendars.
GOOGLE_CALENDAR_ID=
# Optional split routing: configure both, or leave both empty for the single target above.
GOOGLE_ADE_CALENDAR_ID=
GOOGLE_WORKFORCE_CALENDAR_ID=
# Optional six-agenda ADE routing: configure all six to enable category filtering.
GOOGLE_ADE_IA_CALENDAR_ID=
GOOGLE_ADE_DATA_CALENDAR_ID=
GOOGLE_ADE_COMMON_CALENDAR_ID=
GOOGLE_ADE_ENGLISH_CALENDAR_ID=
GOOGLE_ADE_EXAMS_CALENDAR_ID=
GOOGLE_ADE_HOLIDAYS_CALENDAR_ID=
